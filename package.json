{
  "name": "velowrite",
  "private": true,
  "version": "1.0.0",
  "description": "Ultra-fast, local-first document editor engineered for sub-16ms input latency and 100-page virtualized rendering.",
  "author": "halxo",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/halxo/velowrite.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:publish": "npm run build && electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.halxo.velowrite",
    "productName": "VeloWrite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "VeloWrite-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VeloWrite",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "halxo",
        "repo": "velowrite",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
